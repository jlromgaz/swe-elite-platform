generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String?       @unique
  targetDays   Int           @default(180)
  locale       String        @default("en")
  createdAt    DateTime      @default(now())
  progress     NodeProgress[]
  pillReviews  PillReview[]
  validations  Validation[]
  customNodes  CustomNode[]
  resourceProgress UserResourceProgress[]
}

model Topic {
  id             String        @id
  slug           String        @unique
  title          String
  category       String
  estimatedHours Float
  dependsOn      String
  isRequired     Boolean       @default(true)
  resources      Resource[]
  pills          Pill[]
  progress       NodeProgress[]
  validations    Validation[]
}

model NodeProgress {
  id         String    @id @default(uuid())
  userId     String
  topicId    String
  user       User      @relation(fields: [userId], references: [id])
  topic      Topic     @relation(fields: [topicId], references: [id])
  state      String    @default("locked")
  startedAt  DateTime?
  masteredAt DateTime?

  @@unique([userId, topicId])
  @@index([userId, state])
}

model Resource {
  id          String  @id @default(uuid())
  topicId     String
  topic       Topic   @relation(fields: [topicId], references: [id])
  type        String
  title       String
  url         String
  locale      String  @default("en")
  durationMin Int?
  quality     Int     @default(5)
  progress    UserResourceProgress[]
}

model UserResourceProgress {
  id         String   @id @default(uuid())
  userId     String
  resourceId String
  user       User     @relation(fields: [userId], references: [id])
  resource   Resource @relation(fields: [resourceId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([userId])
}

model Pill {
  id      String       @id @default(uuid())
  topicId String
  topic   Topic        @relation(fields: [topicId], references: [id])
  content String
  locale  String       @default("en")
  reviews PillReview[]
}

model PillReview {
  id          String   @id @default(uuid())
  userId      String
  pillId      String
  user        User     @relation(fields: [userId], references: [id])
  pill        Pill     @relation(fields: [pillId], references: [id])
  reviewCount Int      @default(0)
  nextReview  DateTime
  lastScore   Int?

  @@unique([userId, pillId])
}

model Validation {
  id          String   @id @default(uuid())
  userId      String
  topicId     String
  user        User     @relation(fields: [userId], references: [id])
  topic       Topic    @relation(fields: [topicId], references: [id])
  type        String
  question    String
  answer      String?
  score       Int?
  passed      Boolean  @default(false)
  attemptedAt DateTime @default(now())
}

model CustomNode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  dependsOn String   @default("[]")
  createdAt DateTime @default(now())

  @@index([userId])
}
